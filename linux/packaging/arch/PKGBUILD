# Maintainer: DiyarDesk contributors
pkgname=diyardesk
pkgver=0.5.7
pkgrel=1
pkgdesc="DiyarDesk — native Rust OpenGL 3.3 & HTML/CSS/JS adaptive wallpaper that follows desktop icons"
arch=('x86_64' 'aarch64')
url="https://github.com/adam0307a/DiyarDesk"
license=('GPL-3.0-only')
options=('!debug')
makedepends=('gettext' 'cargo' 'cmake')
provides=('deskland-preview')
conflicts=('deskland-preview')
replaces=('deskland-preview')
depends=(
  'python'
  'python-gobject'
  'python-cairo'
  'gtk3'
  'webkit2gtk-4.1'
  'libayatana-appindicator'
  'xdg-utils'
  'libglvnd'
)
optdepends=(
  'gtk-layer-shell: Wayland layer-shell wallpaper backend'
  'xdotool: automatic pause on X11'
  'gst-plugins-good: background audio playback in WebKitGTK themes'
  'qt6-declarative: native Rust OpenGL 3.3 KDE Plasma 6 wallpaper plugin'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/adam0307a/DiyarDesk/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  local src="$srcdir/DiyarDesk-$pkgver"
  (cd "$src/native/diyardesk-gl" && cargo build --release --locked)
  if [ -d /usr/include/qt6/QtQuick ]; then
    cmake -S "$src/linux/plasma-gl-plugin" \
          -B "$src/linux/plasma-gl-plugin/build" \
          -DCMAKE_BUILD_TYPE=Release
    cmake --build "$src/linux/plasma-gl-plugin/build" -j"$(nproc)"
  fi
}

package() {
  local src="$srcdir/DiyarDesk-$pkgver"

  install -d "$pkgdir/usr/lib/deskland/linux/deskland_linux" \
             "$pkgdir/usr/lib/deskland/prototype" \
             "$pkgdir/usr/bin" \
             "$pkgdir/usr/share/applications" \
             "$pkgdir/usr/share/icons/hicolor/scalable/apps" \
             "$pkgdir/usr/share/plasma/wallpapers" \
             "$pkgdir/usr/share/plasma/plasmoids" \
             "$pkgdir/usr/share/gnome-shell/extensions" \
             "$pkgdir/usr/share/licenses/$pkgname"

  cp -a "$src/linux/deskland_linux/." "$pkgdir/usr/lib/deskland/linux/deskland_linux/"
  cp -a "$src/prototype/." "$pkgdir/usr/lib/deskland/prototype/"
  cp -a "$src/linux/plasma-wallpaper/org.deskland.preview" "$pkgdir/usr/share/plasma/wallpapers/"
  cp -a "$src/linux/kde-iconspy/org.deskland.iconspy" "$pkgdir/usr/share/plasma/plasmoids/"
  cp -a "$src/linux/gnome-extension/deskland@deskland.app" "$pkgdir/usr/share/gnome-shell/extensions/"

  if [ -f "$src/native/diyardesk-gl/target/release/libdiyardesk_gl.so" ]; then
    install -m755 "$src/native/diyardesk-gl/target/release/libdiyardesk_gl.so" \
      "$pkgdir/usr/lib/deskland/libdiyardesk_gl.so"
  fi
  if [ -f "$src/linux/plasma-gl-plugin/build/libdiyardesk_plasma_gl.so" ]; then
    install -d "$pkgdir/usr/share/plasma/wallpapers/org.deskland.preview/contents/ui/gl"
    install -m755 "$src/linux/plasma-gl-plugin/build/libdiyardesk_plasma_gl.so" \
      "$pkgdir/usr/share/plasma/wallpapers/org.deskland.preview/contents/ui/gl/libdiyardesk_plasma_gl.so"
    install -m644 "$src/linux/plasma-gl-plugin/qmldir" \
      "$pkgdir/usr/share/plasma/wallpapers/org.deskland.preview/contents/ui/gl/qmldir"
    ln -sf /usr/lib/deskland/libdiyardesk_gl.so \
      "$pkgdir/usr/share/plasma/wallpapers/org.deskland.preview/contents/ui/gl/libdiyardesk_gl.so"
  fi
  # Compile gettext catalogs into the system locale tree when present;
  # system extensions bind to Config.LOCALEDIR when no locale/ subfolder is shipped.
  if [ -f "$src/linux/gnome-extension/build-mo.sh" ]; then
    sh "$src/linux/gnome-extension/build-mo.sh" "$pkgdir/usr/share/locale"
  fi
  rm -rf "$pkgdir/usr/share/gnome-shell/extensions/deskland@deskland.app/locale" \
         "$pkgdir/usr/share/gnome-shell/extensions/deskland@deskland.app/po"
  install -m644 "$src/linux/packaging/deskland.desktop" \
    "$pkgdir/usr/share/applications/deskland.desktop"
  install -m644 "$src/linux/packaging/deskland.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/deskland.svg"
  install -m644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  cat > "$pkgdir/usr/bin/deskland-linux" <<'EOF'
#!/bin/sh
export PYTHONPATH="/usr/lib/deskland/linux${PYTHONPATH:+:$PYTHONPATH}"
export DESKLAND_PROTOTYPE="${DESKLAND_PROTOTYPE:-/usr/lib/deskland/prototype}"
exec python3 -m deskland_linux "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/deskland-linux"
  ln -sf /usr/bin/deskland-linux "$pkgdir/usr/bin/diyardesk"
  install -m755 "$src/linux/bin/diyardesk-ctl" "$pkgdir/usr/bin/diyardesk-ctl"
}
