{
  "name": "Neon Icon Pulse (GLSL)",
  "desc": "OpenGL 3.3 Core GLSL example theme that wraps desktop icons in interactive neon aura rings.",
  "engine": "opengl-glsl",
  "shader": "main.frag",
  "adaptive": true,
  "groups": [
    {
      "name": "Appearance",
      "params": [
        {
          "key": "speed",
          "label": "Wave Speed",
          "min": 0.2,
          "max": 3.0,
          "step": 0.05,
          "default": 1.0,
          "format": "times"
        },
        {
          "key": "glow",
          "label": "Icon Glow",
          "min": 0.1,
          "max": 2.0,
          "step": 0.05,
          "default": 1.0,
          "format": "percent"
        },
        {
          "key": "accent",
          "label": "Accent Color",
          "type": "color",
          "default": "#32c5b8"
        }
      ]
    }
  ]
}
